[user]
    name = Gélules
    email = gelules.cours@gmail.com

[alias]
    st = status
    pl = pull
    ph = push

[init]
    defaultBranch = master
[pull]
    rebase = true
[rebase]
    autoStash = true
[fetch]
    prune = true
[push]
    autoSetupRemote = true
[merge]
    conflictStyle = zdiff3
[diff]
    algorithm = histogram
[rerere]
    enabled = true
# git-delta: coloured diffs, side by side with line numbers. n / N jump between files.
# In a narrow terminal: git -c delta.side-by-side=false diff
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = true
